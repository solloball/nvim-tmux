{"name":"vs-code-all-setting","settings":"{\"settings\":\"{        \\n\\t//Main editor settings\\n\\t\\\"editor.tabSize\\\": 2,\\n\\t\\\"editor.folding\\\": false,\\n\\t\\\"editor.insertSpaces\\\": false,\\n\\t\\\"editor.smoothScrolling\\\": true,\\n\\t\\\"editor.minimap.sectionHeaderFontSize\\\": 18,\\n\\t\\\"editor.minimap.enabled\\\": false,\\n\\t\\\"editor.detectIndentation\\\": true,\\n\\t\\\"editor.suggestSelection\\\": \\\"first\\\",\\n\\t\\\"editor.multiCursorModifier\\\": \\\"ctrlCmd\\\",\\n\\t\\\"window.zoomLevel\\\": 2,\\n\\t\\\"editor.minimap.showSlider\\\": \\\"always\\\",\\n\\t\\\"editor.minimap.renderCharacters\\\": false,\\n\\n\\t// Wrapping\\n\\t\\\"editor.wordWrap\\\": \\\"bounded\\\",\\n\\t\\\"editor.wrappingIndent\\\": \\\"same\\\",\\n\\t\\\"editor.wordWrapColumn\\\": 80,\\n\\n\\t// Auto closing tags\\n\\t\\\"html.autoClosingTags\\\": true,\\n\\t\\\"javascript.autoClosingTags\\\": true,\\n\\t\\\"typescript.autoClosingTags\\\": true,\\n\\n\\t//Определяет, будет ли редактор прокручиваться за пределы последней строки.\\n\\t\\\"editor.scrollBeyondLastLine\\\": true,\\n\\n\\t// Rename tags\\n\\t\\\"editor.linkedEditing\\\": true,\\n\\n\\t//Определяет, должен ли редактор отображать управляющие символы.\\n\\t\\\"editor.renderControlCharacters\\\": false,\\n\\n\\t//Управляет выделением символов, которые можно спутать с основными символами ASCII, кроме тех, которые являются общими для текущего пользовательского языкового стандарта.\\n\\t\\\"editor.unicodeHighlight.ambiguousCharacters\\\": false,\\n\\n\\t//Appearance\\n\\t\\\"editor.bracketPairColorization.enabled\\\": false,\\n\\t\\\"editor.glyphMargin\\\": false,\\n\\t\\\"editor.scrollbar.horizontal\\\": \\\"hidden\\\",\\n\\t\\\"editor.scrollbar.vertical\\\": \\\"hidden\\\",\\n\\t\\\"window.density.editorTabHeight\\\": \\\"compact\\\",\\n\\t\\\"editor.accessibilitySupport\\\": \\\"off\\\",\\n\\t\\\"window.commandCenter\\\": false,\\n\\t\\\"workbench.layoutControl.enabled\\\": false,\\n\\t\\\"workbench.iconTheme\\\": \\\"quill-icons-minimal\\\",\\n\\t\\\"window.menuBarVisibility\\\": \\\"hidden\\\",\\n\\n\\t\\\"workbench.editor.enablePreview\\\": false,\\n\\t\\\"workbench.editor.pinnedTabSizing\\\": \\\"compact\\\",\\n\\t\\\"workbench.statusBar.visible\\\": true,\\n\\n\\t// Font\\n\\t\\\"editor.fontSize\\\": 19,\\n\\t\\\"editor.lineHeight\\\": 30,\\n\\t\\\"editor.fontLigatures\\\": true,\\n\\t\\\"editor.inlayHints.fontFamily\\\": \\\"JetBrains Mono\\\",\\n\\t\\\"editor.fontFamily\\\": \\\"JetBrains Mono\\\",\\n\\t\\\"editor.titleBar.enabled\\\": false,\\n\\n\\t//Explorer\\n\\t\\\"explorer.confirmDelete\\\": false,\\n\\t\\\"explorer.compactFolders\\\": false,\\n\\t\\\"explorer.confirmDragAndDrop\\\": false,\\n\\t//Разрешить уменьшение размера вкладок, когда доступного места недостаточно для отображения всех вкладок одновременно.\\n\\t\\\"workbench.editor.tabSizing\\\": \\\"shrink\\\",\\n\\t\\\"workbench.startupEditor\\\": \\\"none\\\",\\n\\n\\t//Debug\\n\\t\\\"debug.toolBarLocation\\\": \\\"hidden\\\",\\n\\t\\\"debug.focusWindowOnBreak\\\": false,\\n\\t\\\"debug.showInlineBreakpointCandidates\\\": true,\\n\\t\\\"debug.showBreakpointsInOverviewRuler\\\": true,\\n\\n\\t//Breadcrumbs\\n\\t\\\"breadcrumbs.icons\\\": false,\\n\\t\\\"breadcrumbs.showKeys\\\": false,\\n\\t\\\"breadcrumbs.showFiles\\\": false,\\n\\t\\\"breadcrumbs.symbolPath\\\": \\\"off\\\",\\n\\t\\\"breadcrumbs.showArrays\\\": false,\\n\\t\\\"breadcrumbs.showEvents\\\": false,\\n\\t\\\"breadcrumbs.showFields\\\": false,\\n\\t\\\"breadcrumbs.showClasses\\\": false,\\n\\t\\\"breadcrumbs.showMethods\\\": false,\\n\\t\\\"breadcrumbs.showBooleans\\\": false,\\n\\t\\\"breadcrumbs.showFunctions\\\": false,\\n\\t\\\"breadcrumbs.showConstants\\\": false,\\n\\t\\\"breadcrumbs.showEnumMembers\\\": false,\\n\\t\\\"breadcrumbs.showConstructors\\\": false,\\n\\n \\t// OTHER\\n\\t// Язык по умолчанию для новых файлов\\n\\t\\\"files.defaultLanguage\\\": \\\"plaintext\\\",\\n\\t// Игнорировать пробелы при сравнении в редакторе diff\\n\\t\\\"diffEditor.ignoreTrimWhitespace\\\": false,\\n\\t// Открытие не доверенных файлов без предупреждения\\n\\t\\\"security.workspace.trust.untrustedFiles\\\": \\\"open\\\",\\n\\t// Автоматически изменять предложение автозаполнения на основе предыдущего выбора\\n\\t\\\"vsintellicode.modify.editor.suggestSelection\\\": \\\"automaticallyOverrodeDefaultValue\\\",\\n\\t// Подтверждение перед закрытием окна только при использовании клавиатуры\\n\\t\\\"window.confirmBeforeClose\\\": \\\"keyboardOnly\\\",\\n\\t// Не открывать репозиторий в родительских папках\\n\\t\\\"git.openRepositoryInParentFolders\\\": \\\"never\\\",\\n\\n \\t// Поведение при обнаружении нескольких определений\\n\\t\\\"editor.gotoLocation.multipleDefinitions\\\": \\\"goto\\\",\\n\\t// Скрыть подсказку в пустом редакторе\\n\\t\\\"workbench.editor.empty.hint\\\": \\\"hidden\\\",\\n\\n \\t// sticky\\n\\t\\\"editor.stickyScroll.enabled\\\": false,\\n\\t\\\"workbench.tree.enableStickyScroll\\\": false,\\n\\n\\t\\\"git.confirmSync\\\": false,\\n\\t\\\"redhat.telemetry.enabled\\\": false,\\n\\n\\t// vim\\n\\t\\\"vim.normalModeKeyBindings\\\": [\\n\\t\\t\\t{\\n\\t\\t\\t\\t\\t\\\"before\\\": [\\\"J\\\"],\\n\\t\\t\\t\\t\\t\\\"after\\\": [\\\"j\\\"]\\n\\t\\t\\t},\\n\\t\\t\\t{\\n\\t\\t\\t\\t\\t\\\"before\\\": [\\\"K\\\"],\\n\\t\\t\\t\\t\\t\\\"after\\\": [\\\"k\\\"]\\n\\t\\t\\t},\\n\\t\\t\\t{\\n\\t\\t\\t\\t\\t\\\"before\\\": [\\\"H\\\"],\\n\\t\\t\\t\\t\\t\\\"after\\\": [\\\"h\\\"]\\n\\t\\t\\t},\\n\\t\\t\\t{\\n\\t\\t\\t\\t\\t\\\"before\\\": [\\\"L\\\"],\\n\\t\\t\\t\\t\\t\\\"after\\\": [\\\"l\\\"]\\n\\t\\t\\t},\\n\\t\\t\\t{\\n\\t\\t\\t\\t\\t\\\"before\\\": [\\\"J\\\"],\\n\\t\\t\\t\\t\\t\\\"after\\\": [\\\"j\\\"]\\n\\t\\t\\t},\\n\\t\\t\\t{\\n\\t\\t\\t\\t\\t\\\"before\\\": [\\\"W\\\"],\\n\\t\\t\\t\\t\\t\\\"after\\\": [\\\"w\\\"]\\n\\t\\t\\t},\\n\\t\\t\\t{\\n\\t\\t\\t\\t\\t\\\"before\\\": [\\\"I\\\"],\\n\\t\\t\\t\\t\\t\\\"after\\\": [\\\"i\\\"]\\n\\t\\t\\t},\\n\\t],\\n  \\\"vim.incsearch\\\": true,\\n  \\\"vim.useSystemClipboard\\\": true,\\n  \\\"vim.useCtrlKeys\\\": false,\\n  \\\"vim.hlsearch\\\": true,\\n\\t// To improve performance\\n  \\\"extensions.experimental.affinity\\\": {\\n    \\\"vscodevim.vim\\\": 1\\n  },\\n\\t\\\"vim.normalModeKeyBindingsNonRecursive\\\": [\\n    {\\n      \\\"before\\\": [\\\"<leader>\\\", \\\"3\\\"],\\n      \\\"after\\\": [\\\"d\\\", \\\"d\\\"]\\n    },\\n  ],\\n\\n\\t\\\"editor.largeFileOptimizations\\\": true,\\n\\t\\\"window.customTitleBarVisibility\\\": \\\"auto\\\",\\n\\n\\t// telemetry\\n\\t\\\"telemetry.telemetryLevel\\\": \\\"off\\\",\\n\\n\\t// tabs\\n\\t\\\"workbench.editor.showTabs\\\": \\\"multiple\\\",\\n\\t\\\"window.newWindowProfile\\\": \\\"Default\\\",\\n\\t\\\"workbench.colorTheme\\\": \\\"Dark Night Owl\\\",\\n\\t\\\"workbench.activityBar.location\\\": \\\"hidden\\\",\\n\\n\\n\\t// spell checker\\n\\t\\\"cSpell.enabled\\\": true,\\n\\t\\\"extensions.ignoreRecommendations\\\": true,\\n\\t\\\"typescript.updateImportsOnFileMove.enabled\\\": \\\"never\\\",\\n\\t\\\"files.associations\\\": {\\n\\t\\t\\\"*.kt\\\": \\\"kotlin\\\"\\n\\t},\\n\\t\\\"kotlin.languageServer.enabled\\\": false,\\n\\t\\\"kotlin.debugAdapter.enabled\\\": false,\\n\\t\\\"cSpell.language\\\": \\\"en,ru\\\"\\n}\"}","keybindings":"{\"keybindings\":\"// Place your key bindings in this file to override the defaults\\n[\\n    {\\n        \\\"key\\\": \\\"ctrl+shift+f12\\\",\\n        \\\"command\\\": \\\"editor.action.peekImplementation\\\",\\n        \\\"when\\\": \\\"editorHasImplementationProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+shift+f12\\\",\\n        \\\"command\\\": \\\"-editor.action.peekImplementation\\\",\\n        \\\"when\\\": \\\"editorHasImplementationProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+shift+b\\\",\\n        \\\"command\\\": \\\"extension.vim_ctrl+b\\\",\\n        \\\"when\\\": \\\"editorTextFocus && vim.active && vim.use<C-b> && !inDebugRepl && vim.mode != 'Insert'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+b\\\",\\n        \\\"command\\\": \\\"-extension.vim_ctrl+b\\\",\\n        \\\"when\\\": \\\"editorTextFocus && vim.active && vim.use<C-b> && !inDebugRepl && vim.mode != 'Insert'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+shift+u\\\",\\n        \\\"command\\\": \\\"workbench.view.extension.spring\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+shift+-\\\",\\n        \\\"command\\\": \\\"cSpell.enableForWorkspace\\\"\\n    },\\n]\",\"platform\":2}","extensions":"[{\"identifier\":{\"id\":\"vscode.github-authentication\"},\"displayName\":\"GitHub Authentication\",\"disabled\":true,\"applicationScoped\":false},{\"identifier\":{\"id\":\"bradlc.vscode-tailwindcss\",\"uuid\":\"4db62a7c-7d70-419c-96d2-6c3a4dc77ea5\"},\"displayName\":\"Tailwind CSS IntelliSense\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"bruceyuhb.hsl-preview\",\"uuid\":\"21b9a2e7-f407-420b-b56f-91a368f09ec4\"},\"displayName\":\"HSL Color Preview\",\"disabled\":true,\"applicationScoped\":false},{\"identifier\":{\"id\":\"cdonohue.quill-icons\",\"uuid\":\"b01b79ca-bf6d-45ad-ac80-107f77d6a82d\"},\"displayName\":\"Quill Icons\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"dbaeumer.vscode-eslint\",\"uuid\":\"583b2b34-2c1e-4634-8c0b-0b82e283ea3a\"},\"displayName\":\"ESLint\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"docker.docker\",\"uuid\":\"aa98a064-0f79-4961-a4b7-78df16d547ee\"},\"displayName\":\"Docker DX\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"fwcd.kotlin\",\"uuid\":\"c86bc8a9-fd3b-44db-b28a-2d146cb78d3c\"},\"displayName\":\"Kotlin\",\"disabled\":true,\"applicationScoped\":false},{\"identifier\":{\"id\":\"kamikillerto.vscode-colorize\",\"uuid\":\"445ba381-f232-4150-9056-d790bd76d698\"},\"displayName\":\"colorize\",\"disabled\":true,\"applicationScoped\":false},{\"identifier\":